{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Segmentation Trainer",
            "type": "debugpy",
            "request": "launch",
            "program": "segmentation_trainer.py",
            "args": [
                "--dataset", "cityscapes",
                "--data-root", "/root/data/LwS-main/datasets/Cityscapes",
                "--img-size", "256", "512",
                "--batch-size", "2",
                "--optimizer", "adam", "--lr", "1.5e-3",
                "--backbone-lr-factor", "0.3",
                "--lr-scheduler", "poly",
                "--num-epochs", "160",
                "--subsample-percentage", "100.0",
                "--debug"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "CUDA C++: Debug",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "/root/Projects/HyperbolicCV/code/lib/lorentz/layers/cuda_kernel/hyperbolic_conv2d_kernel.so",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "cuda-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for cuda-gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
