    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Segmentation Trainer",
            "type": "debugpy",
            "request": "launch",
            "program": "segmentation_trainer.py",
            "args": [
                "--dataset", "cityscapes",
                "--data-root", "/root/data/LwS-main/datasets/Cityscapes",
                "--img-size", "256", "512",
                "--batch-size", "2",
                "--optimizer", "adam", "--lr", "1.5e-3",
                "--backbone-lr-factor", "0.3",
                "--lr-scheduler", "poly",
                "--num-epochs", "160",
                "--subsample-percentage", "100.0",
                "--debug"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
